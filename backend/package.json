{
  "name": "pickup-counter-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=../.env --import tsx src/db/cli.ts seed",
    "db:setup": "node --env-file-if-exists=../.env --import tsx src/db/cli.ts migrate seed",
    "send-webhook": "node --env-file-if-exists=../.env --import tsx src/scripts/send-webhook.ts",
    "send-webhook:dist": "node dist/scripts/send-webhook.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
