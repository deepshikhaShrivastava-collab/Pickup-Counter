# Copy to .env and change every value. Never commit .env.
# Use URL-safe characters (letters, digits, - _) in the password; it is embedded in connection URLs.

POSTGRES_USER=pickup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pickup

# Host port for the compose Postgres (5433 avoids clashing with a locally installed Postgres)
DB_HOST_PORT=5433

# Shared secret for payment webhook HMAC-SHA256 signatures (min 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-hex-string

# Used when running the backend, scripts and tests on the host against the compose database
DATABASE_URL=postgres://pickup:change-me@localhost:5433/pickup
# Integration tests DROP and recreate this database; its name must contain "test"
TEST_DATABASE_URL=postgres://pickup:change-me@localhost:5433/pickup_test

# Optional
# API_PORT=4000
# EXPIRY_SWEEP_MS=5000
