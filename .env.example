# Copy to .env and change every value. Never commit .env.
# Use URL-safe characters (letters, digits, - _) in the password; it is embedded in connection URLs.

# --- Local development (no Docker) -------------------------------------------------
# Backend, scripts and tests connect to a local PostgreSQL (13+) using these URLs.
# The role needs CREATEDB so the tests can recreate their own database (see README).
DATABASE_URL=postgres://pickup:change-me@localhost:5432/pickup
# Integration tests DROP and recreate this database; its name must contain "test"
TEST_DATABASE_URL=postgres://pickup:change-me@localhost:5432/pickup_test

# Shared secret for payment webhook HMAC-SHA256 signatures (min 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-hex-string

# Optional
# PORT=4000
# EXPIRY_SWEEP_MS=5000

# --- Docker Compose only -----------------------------------------------------------
POSTGRES_USER=pickup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pickup
# Host port for the compose Postgres (5433 avoids clashing with a local install on 5432)
DB_HOST_PORT=5433
# API_PORT=4000
# WEB_PORT=8080
